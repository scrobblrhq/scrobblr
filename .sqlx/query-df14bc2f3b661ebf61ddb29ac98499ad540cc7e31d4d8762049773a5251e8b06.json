  "query": "\n        SELECT id, name, name_normalized, mbid, image_url, bio,\n               CASE WHEN artist_has_listeners(id, $2) THEN scrobble_count END\n                   AS \"scrobble_count?\",\n               NULL::bigint AS \"listener_count?\", created_at\n        FROM artists\n        WHERE id = $1\n        ",
