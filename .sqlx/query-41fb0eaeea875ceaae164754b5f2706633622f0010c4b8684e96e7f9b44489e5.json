{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT u.id, (u.created_at AT TIME ZONE 'UTC')::date AS \"registered!\",\n               o.key_id AS \"key_id?\", o.address AS \"address?\", o.network AS \"network?\"\n        FROM users u\n        LEFT JOIN registration_origins o ON o.user_id = u.id\n        WHERE u.id = ANY($1)\n        ",
