  "query": "\n        UPDATE tracks\n        SET album_id    = COALESCE(album_id, $2),\n            duration_ms = COALESCE(duration_ms, $3)\n        WHERE id = $1\n        RETURNING id, artist_id, album_id, title, title_normalized, mbid,\n                  duration_ms, scrobble_count, created_at\n        ",
