  "query": "\n        SELECT n.neighbour_id AS artist_id, a.name, n.score::bigint AS \"score!\",\n               n.listeners::bigint AS \"listeners!\"\n        FROM artist_neighbours n JOIN artists a ON a.id = n.neighbour_id\n        WHERE n.artist_id = $1\n        ORDER BY n.position\n        ",
