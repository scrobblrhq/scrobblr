  "query": "\n        SELECT t.name, c.weight\n        FROM tag_counts c JOIN tags t ON t.id = c.tag_id\n        WHERE c.entity_type = $1 AND c.entity_id = $2 AND c.weight >= $3\n        ORDER BY c.weight DESC, c.tag_id\n        LIMIT $4\n        ",
