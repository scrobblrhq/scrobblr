  "query": "\n                SELECT al.id AS \"entity_id!\", al.title AS \"name!\", al.artist_id AS \"artist_id!\",\n                       a.name AS \"artist_name!\", al.image_url AS image\n                FROM albums al\n                JOIN artists a ON a.id = al.artist_id\n                WHERE al.id = ANY($1)\n                ",
