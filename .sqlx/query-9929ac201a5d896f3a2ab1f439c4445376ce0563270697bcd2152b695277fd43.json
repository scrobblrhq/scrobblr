  "query": "\n        SELECT b.revision_id, b.locked_at IS NOT NULL AS \"locked!\", r.body AS \"body?\"\n        FROM entity_bios b\n        LEFT JOIN bio_revisions r ON r.id = b.revision_id\n        WHERE b.entity_type = $1 AND b.entity_id = $2\n        FOR UPDATE OF b\n        ",
