  "query": "\n        SELECT al.id, al.artist_id, a.name AS artist_name, al.title, al.title_normalized,\n               al.mbid, al.image_url, al.release_date,\n               NULL::bigint AS \"scrobble_count?\", al.created_at\n        FROM albums al\n        JOIN artists a ON a.id = al.artist_id\n        WHERE al.id = $1\n        ",
