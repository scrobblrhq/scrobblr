{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT s.id, s.played_at, s.track_id, s.source,\n               COALESCE(t.duration_ms, s.duration_ms) AS \"duration_ms?\"\n        FROM scrobbles s\n        JOIN tracks t ON t.id = s.track_id\n        WHERE s.user_id = $1\n          AND s.played_at > $2\n          AND s.played_at < $3\n        ORDER BY s.played_at, s.id\n        ",
