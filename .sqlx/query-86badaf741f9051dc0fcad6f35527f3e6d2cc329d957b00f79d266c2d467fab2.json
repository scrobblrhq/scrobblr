  "query": "\n        SELECT d.classified_at, d.max_scrobble_id,\n               (u.created_at AT TIME ZONE 'UTC')::date AS \"created!\"\n        FROM scrobble_classification_days d\n        JOIN users u ON u.id = d.user_id\n        WHERE d.user_id = $1 AND d.day = $2\n        ",
