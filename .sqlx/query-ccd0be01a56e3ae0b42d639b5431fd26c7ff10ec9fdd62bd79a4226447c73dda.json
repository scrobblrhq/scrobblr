{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT t.id AS \"entity_id!\", t.title AS \"name!\", t.artist_id AS \"artist_id!\",\n                       a.name AS \"artist_name!\", al.image_url AS \"image?\"\n                FROM tracks t\n                JOIN artists a ON a.id = t.artist_id\n                LEFT JOIN albums al ON al.id = t.album_id\n                WHERE t.id = ANY($1)\n                ",
