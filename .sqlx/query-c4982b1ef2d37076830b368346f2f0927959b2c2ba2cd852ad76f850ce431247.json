  "query": "\n        SELECT r.created_at, r.revision_id, t.name AS \"tag?\", r.entity_type, r.entity_id,\n               r.reason, r.note, r.status, r.resolved_at\n        FROM reports r\n        LEFT JOIN tags t ON t.id = r.tag_id\n        WHERE r.reporter_id = $1\n        ORDER BY r.created_at\n        ",
