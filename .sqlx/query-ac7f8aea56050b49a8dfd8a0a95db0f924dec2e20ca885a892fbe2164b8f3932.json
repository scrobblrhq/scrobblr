  "query": "\n        SELECT k.artist_id, a.name AS artist_name, k.skipped_at, k.until\n        FROM recommendation_skips k\n        JOIN artists a ON a.id = k.artist_id\n        WHERE k.user_id = $1\n        ORDER BY k.skipped_at DESC, k.artist_id\n        ",
