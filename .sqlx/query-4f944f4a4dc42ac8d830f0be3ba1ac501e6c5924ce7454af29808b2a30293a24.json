  "query": "\n        SELECT id, artist_id, album_id, title, title_normalized, mbid, duration_ms,\n               CASE WHEN track_has_listeners(id, $2) THEN scrobble_count END\n                   AS \"scrobble_count?\",\n               created_at\n        FROM tracks\n        WHERE id = $1\n        ",
