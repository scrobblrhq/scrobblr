  "query": "\n        SELECT id, created_at, expires_at, last_used_at, ip_address::text AS ip_address,\n               user_agent, FALSE AS \"current!\"\n        FROM user_sessions\n        WHERE user_id = $1 AND expires_at > NOW()\n        ORDER BY created_at\n        ",
