# Settings for `cargo run` (devenv and dotenvy read .env). These are the
# ones a development machine needs; every other setting, with what it does,
# is in .env.docker.example: the same names work here, uncommented.

# Database. A password with characters a URL reserves (/ # ? and so on)
# must be percent-encoded here, or left out and set as PGPASSWORD.
DATABASE_URL=postgresql://postgres:password@localhost:5432/scrobblr
# PGPASSWORD=

# Redis. REDIS_PASSWORD, when set, replaces the password in REDIS_URL and
# may hold any character.
REDIS_URL=redis://127.0.0.1:6379
# REDIS_PASSWORD=

# API server bind address
BIND_ADDR=0.0.0.0:8080

# Logging (see tracing-subscriber EnvFilter docs)
# App logs live under the crate targets api/worker/db; sqlx=warn hides query
# noise, tower_http=debug shows HTTP request logs.
RUST_LOG=api=debug,worker=debug,db=debug,sqlx=warn,tower_http=debug

# External base URL clients reach the API on, for the links it builds to
# itself and the image URLs: the emulator's host for local mobile dev.
PUBLIC_BASE_URL=http://10.0.2.2:8080

# Directory uploaded images are written to (default: ./uploads).
# UPLOAD_DIR=uploads

# The browser extension against a local http:// API needs its origin
# (chrome-extension://<id>) or * here.
# CORS_ALLOWED_ORIGINS=
