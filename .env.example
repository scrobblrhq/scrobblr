# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/scrobblr

# Redis
REDIS_URL=redis://127.0.0.1:6379

# API server bind address
BIND_ADDR=0.0.0.0:8080

# Logging (see tracing-subscriber EnvFilter docs)
# App logs live under the crate targets api/worker/db; sqlx=warn hides query
# noise, tower_http=debug shows HTTP request logs.
RUST_LOG=api=debug,worker=debug,db=debug,sqlx=warn,tower_http=debug

# Postgres pool size (optional, default: 20)
# DB_MAX_CONNECTIONS=20

# Last.fm API key (optional — enables artist bios in metadata enrichment)
# LASTFM_API_KEY=

# Spotify connected accounts (optional — enables linking Spotify via OAuth
# so the worker can auto-scrobble from Spotify's official API). Register an
# app at https://developer.spotify.com/dashboard to get these; the redirect
# URI must exactly match one registered there and point at this API's own
# callback route.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/v1/connect/spotify/callback

# Required whenever SPOTIFY_CLIENT_ID is set (the API refuses to start
# without it): the AES-256-GCM key used to encrypt connected-account OAuth
# tokens at rest, so a leaked dump/backup/snapshot doesn't hand out access
# to users' streaming accounts. 32 random bytes, base64-encoded — generate
# with `openssl rand -base64 32`. Store it outside the database backups;
# losing or rotating it makes stored tokens undecryptable and forces every
# user to reconnect.
# TOKEN_ENCRYPTION_KEY=

# First-party client attestation for /v1/auth/register and /v1/auth/login.
# Comma-separated app_id:base64secret pairs (32+ bytes each, e.g.
# `openssl rand -base64 32`). Clients sign every auth request with
# HMAC-SHA256 over "METHOD\npath\ntimestamp\nnonce\nsha256(body)" and send
# X-App-Id, X-App-Timestamp, X-App-Nonce and X-App-Signature; the timestamp
# window is 5 minutes and each nonce is single-use.
# Leave unset to accept unsigned clients. Note that a secret shipped inside
# an extension or an APK is extractable, so this raises the cost of scripted
# abuse rather than acting as a real trust boundary — rate limiting is still
# what actually protects these endpoints.
# AUTH_APP_KEYS=extension:...,mobile:...

# Image uploads (avatars, community artist/album art)
# Directory the images are written to (default: ./uploads)
# UPLOAD_DIR=uploads
# External base URL clients reach the API on; stored image URLs are
# {PUBLIC_BASE_URL}/uploads/{file}. Set this to your public origin in prod
# (e.g. https://api.scrobblr.example), or the emulator host for local mobile dev.
PUBLIC_BASE_URL=http://10.0.2.2:8080
