# Copy to .env.docker and pass with:  docker compose --env-file .env.docker up -d --build
# These configure the Docker stack (docker-compose.yml). They are SEPARATE from
# the repo's app-level .env used for `cargo run` on the host.

# --- Postgres ---
POSTGRES_USER=scrobblr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scrobblr

# --- Redis ---
REDIS_PASSWORD=change-me

# --- API ---
# Host port the API is published on (container always listens on 8080).
API_PORT=8080
# Public origin clients reach the API on. Uploaded image URLs are built as
# {PUBLIC_BASE_URL}/uploads/{file} — set this to your real origin in production
# (e.g. https://api.scrobblr.example).
PUBLIC_BASE_URL=http://localhost:8080

# Reverse proxies in front of the API (default 0). Rate limits key on the
# client's address: with 0 that is the connecting peer and X-Forwarded-For is
# ignored (a client can put anything in it); with N, the entry the outermost
# of N proxies appended. Behind a single nginx or Caddy, use 1.
# TRUSTED_PROXY_HOPS=0

# Optional Last.fm: the API key enables artist bios, history imports and
# track lengths for imported tracks; the shared secret lets users connect
# their Last.fm account and import it through the API, which also needs
# TOKEN_ENCRYPTION_KEY (`openssl rand -base64 32`, keep it out of backups).
# LASTFM_API_KEY=
# LASTFM_SHARED_SECRET=
# TOKEN_ENCRYPTION_KEY=
# Most scrobbles one import may add before it stops.
# LASTFM_IMPORT_MAX_SCROBBLES=1000000

# Scrobbler-compatible APIs: the Last.fm API at /2.0/, Audioscrobbler 1.2
# at / and ListenBrainz at /1/ (docs/scrobbler-clients.md). Third-party apps
# authenticate with scrobbler tokens users create, or Last.fm logins.
# The web app's origin: Last.fm-style apps send the browser to /api/auth/,
# which forwards it to {WEB_APP_URL}/scrobbler/authorize.
# WEB_APP_URL=https://scrobblr.example
# Whether Last.fm-style logins (auth.getMobileSession) take account passwords
# as well as tokens. Default true, but false when AUTH_APP_KEYS is set: an
# unsigned password login here would get around that gate.
# SCROBBLER_PASSWORD_LOGIN=true
# Last.fm API keys whose shared secret you know, as api_key:secret pairs:
# their request signatures are checked. Other keys are accepted (recorded as
# unverified) unless SCROBBLER_STRICT_API_KEYS=true.
# SCROBBLER_API_KEYS=
# SCROBBLER_STRICT_API_KEYS=false
# Scrobbles one account may submit through these APIs per UTC day.
# SCROBBLER_DAILY_LIMIT=3000

# Scrobble classification (worker, shadow mode: labels only, nothing reads
# them yet). A scrobble is suspect when the tracks played in the window ending
# at it add up to more than window * ratio + slack (a skipped track counts
# until the next one starts, a listen reported twice is a duplicate); the
# ratio covers several devices playing at once, the slack imprecise
# durations. Changing any of these reclassifies history in the background.
# Defaults shown.
# CLASSIFIER_WINDOW_SECS=3600
# CLASSIFIER_MAX_RATIO=2.0
# CLASSIFIER_SLACK_SECS=900

# Optional: tracing filter (see tracing-subscriber EnvFilter syntax).
# RUST_LOG=info,sqlx=warn,tower_http=warn
